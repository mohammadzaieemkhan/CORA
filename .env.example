# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@localhost:5432/cora
CORA_SCORER_MODE=nemo

# ── Tier 0 & Tier 1 — Google AI Studio [ACTIVE] ───────────────────────────────
# Tier 0 Primary: Gemma 4 26B (a4b) IT (gemma-4-26b-a4b-it)
# Tier 1 Primary: Gemini 3.5 Flash Lite (gemini-3.5-flash-lite)
GOOGLE_AI_STUDIO_API_KEY=your-google-ai-studio-api-key

# ── OpenRouter (Tier 0 & Tier 1 Fallback) [ACTIVE] ────────────────────────────
# Tier 0 Fallback: Gemma 4 26B (a4b) (google/gemma-4-26b-a4b-it:free)
# Tier 1 Fallback: Google Gemma 2 9B (google/gemma-2-9b-it:free)
OPENROUTER_API_KEY=your-openrouter-api-key

# ── Tier 2 Primary — Meta Muse Glimmer 30B (NVIDIA) [ACTIVE] ─────────────────
NVIDIA_MUSE_GLIMMER_30B_API_KEY=your-nvidia-api-key

# ── Tier 2 Fallback — Nemotron 3.5 Lightning 30B (NVIDIA) [ACTIVE] ────────────
NVIDIA_NEMOTRON_3_5_LIGHTNING_API_KEY=your-nvidia-api-key

# ── Tier 3 Primary — Nemotron 3 Super 120B (NVIDIA) [ACTIVE] ─────────────────
NVIDIA_NEMOTRON_SUPER_API_KEY=your-nvidia-api-key

# ── Tier 3 Fallback — GLM 5.3 Flash (NVIDIA) ─────────────────────────────────
NVIDIA_GLM_5_3_FLASH_API_KEY=your-nvidia-api-key

# ── Tier 4 Primary — Nemotron 3 Ultra 550B (NVIDIA) [ACTIVE] ─────────────────
NVIDIA_NEMOTRON_ULTRA_550B_API_KEY=your-nvidia-api-key

# ── Tier 4 Fallback — Moonshot AI Kimi K3 (NVIDIA) ───────────────────────────
NVIDIA_KIMI_K3_API_KEY=your-nvidia-api-key

# ── Tier Fallback — DeepSeek V4.1 Flash (NVIDIA) ──────────────────────────────
NVIDIA_DEEPSEEK_V4_1_FLASH_API_KEY=your-nvidia-api-key
NVIDIA_API_KEY=your-nvidia-api-key

